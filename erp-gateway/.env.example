# Copie para ".env" e preencha. O ".env" NÃO é versionado.

# ── Credenciais do ERP ───────────────────────────────────────────────────────
# São as MESMAS do .env da ferramenta tkinter. Ficam só nesta máquina: não vão
# para a Vercel nem para o Supabase.
ERP_USER=seu_usuario_aqui
ERP_PASSWORD=sua_senha_aqui

# Os demais têm padrão em config.py e só precisam ser informados para sobrescrever.
# ERP_HOST=26.238.137.203
# ERP_PORT=5432
# ERP_DATABASE=ciclone
# ERP_ENCODING=WIN1252
# ERP_TIMEOUT=15

# ── Onde estão os módulos de consulta ────────────────────────────────────────
# HOJE (seu PC): aponte para a pasta da ferramenta tkinter — sem cópia, mesma
# regra de negócio nos dois.
CICLONE_MODULES=C:/Users/User/Documents/Inventario_App/Apenas_Para_Consulta/Novo_Script_Consulta_Pedidos_de_Venda
#
# NO SERVIDOR (depois): copie config.py, db.py, regras.py e movimentos.py para
# ./ciclone, comente a linha acima e o padrão passa a valer.

# ── Segredo compartilhado com a Edge Function ────────────────────────────────
# Gere um valor forte:  python -c "import secrets; print(secrets.token_urlsafe(48))"
GATEWAY_SECRET=

# ── Ajustes opcionais ────────────────────────────────────────────────────────
# GATEWAY_PORT=8000
# GATEWAY_MAX_LINHAS=20000
# ERP_STATEMENT_TIMEOUT_MS=30000
#
# Docs interativas do FastAPI. Vazio = desligadas (padrão). Para explorar a API
# durante o desenvolvimento, use "/docs" — e desligue de novo depois.
# GATEWAY_DOCS_URL=/docs
